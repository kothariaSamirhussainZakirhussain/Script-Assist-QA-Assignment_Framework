{
  "name": "qa-automation-assignment",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright + TypeScript multi-app test framework",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=\"ui-*\"",
    "test:api": "playwright test --project=\"api-*\"",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:triage": "playwright test --project=triage",
    "test:reliability": "playwright test --repeat-each=5 --workers=4",
    "report": "playwright show-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.14.0",
    "dotenv": "^16.4.5",
    "eslint": "^9.14.0",
    "eslint-plugin-playwright": "^2.0.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.13.0",
    "zod": "^3.23.8"
  }
}
